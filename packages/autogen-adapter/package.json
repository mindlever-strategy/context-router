{
  "name": "@context-router/autogen-adapter",
  "version": "0.5.0",
  "description": "AutoGen adapter for Context Router - structured state, selective context, and coordinated handoffs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindlever-strategy/context-router.git",
    "directory": "packages/autogen-adapter"
  },
  "homepage": "https://github.com/mindlever-strategy/context-router#readme",
  "bugs": {
    "url": "https://github.com/mindlever-strategy/context-router/issues"
  },
  "keywords": [
    "autogen",
    "context-router",
    "agents",
    "multi-agent",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "peerDependencies": {
    "@context-router/sdk": "^0.5.0"
  }
}
